APP_NAME="AlmaxPredictions"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://almaxpredictions.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=newbet
DB_USERNAME=postgres
DB_PASSWORD=change_me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CORS_ALLOWED_ORIGINS=https://almaxpredictions.com
WEBHOOK_SECRET=change_me
ADMIN_INITIAL_PASSWORD=change_me_strong_password

SANCTUM_USER_TOKEN_EXPIRY=2592000
SANCTUM_ADMIN_TOKEN_EXPIRY=43200

JPESA_API_URL=https://my.jpesa.com/api/
JPESA_API_KEY=change_me
JPESA_CALLBACK_URL="${APP_URL}/api/payments/webhook"
JPESA_AGENT_COMMISSION_ENABLED=false
JPESA_AGENT_COMMISSION_RATIO=0.2
JPESA_AGENT_COMMISSION_RECIPIENT_TYPE=business
JPESA_AGENT_COMMISSION_RECIPIENT_EMAIL=agent@example.com
JPESA_AGENT_COMMISSION_RECIPIENT_MOBILE=
JPESA_AGENT_COMMISSION_TRANSFER_ACTION=debit
JPESA_AGENT_COMMISSION_TRANSFER_PT=gwallet
JPESA_AGENT_COMMISSION_CURRENCY=UGX

# AI customer support (server-side only; never expose this key to Vue/browser code)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=45

# Support conversation behavior
SUPPORT_SYSTEM_CONTEXT_PATH=
SUPPORT_DAILY_REPLY_LIMIT=10
SUPPORT_TIMEZONE=Africa/Kampala
SUPPORT_MAX_OUTPUT_TOKENS=800
SUPPORT_HISTORY_MESSAGES=10
SUPPORT_KNOWLEDGE_ARTICLES=8
SUPPORT_MESSAGE_RETENTION_DAYS=365
SUPPORT_JOB_TIMEOUT_SECONDS=240
SUPPORT_JOB_TRIES=2
DB_QUEUE_RETRY_AFTER=300

# Optional WhatsApp support channel
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_INBOUND_WEBHOOK_URL="${APP_URL}/api/support/twilio/inbound"
TWILIO_STATUS_WEBHOOK_URL="${APP_URL}/api/support/twilio/status"
